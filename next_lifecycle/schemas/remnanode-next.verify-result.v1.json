{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "remnanode-next.verify-result.v1",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "policy_hash",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "remnanode-next.verify-result.v1"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
